<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0">
<title>ChronoArchive — Lecho Formation Book</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@500;600;700&family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400&family=Cormorant+SC:wght@600&family=Merriweather:ital,wght@0,300;0,400;0,700;1,400&family=Spectral+SC:wght@500;600&family=Caveat:wght@500;600&display=swap" rel="stylesheet">
<style>
  :root{
    /* --- Design North Star palette, per Chrono Archive UI/UX Bible --- */
    --parchment: #ece0c4;
    --parchment-dark: #ddceaa;
    --parchment-shadow: rgba(60,40,15,0.25);
    --leather: #3b2415;
    --leather-dark: #241408;
    --leather-light: #55321d;
    --brass: #b98a3f;
    --brass-light: #e0bd6f;
    --brass-dark: #7a5a26;
    --ink: #2c2013;
    --ink-soft: #4a3a26;
    --gold-title: #d9b25f;
    /* CGMW color system - Maastrichtian (Upper Cretaceous), per RGB Geologic Time Scale PDF */
    --age-maastrichtian: rgb(166, 216, 74);
    --age-maastrichtian-dark: rgb(120, 165, 45);
    --panel-radius: 6px;
  }
  *{box-sizing:border-box;}
  html,body{
    margin:0; padding:0; min-height:100%;
    background: radial-gradient(ellipse at 50% 0%, #2a1c10 0%, #140c07 70%, #0a0603 100%);
    font-family:'Cormorant Garamond', serif;
    color: var(--ink);
    overflow-x:hidden;
  }
  .stage{
    min-height:100vh;
    display:flex; flex-direction:column; align-items:center; justify-content:center;
    padding: 24px 12px 48px;
  }

  /* ---------------- HUD strip (Main Laboratory HUD echo) ---------------- */
  .hud{
    width:100%; max-width:980px;
    display:flex; align-items:center; justify-content:space-between;
    color:#cbb27f; font-family:'Spectral SC', serif; font-size:11px; letter-spacing:.08em; text-transform:uppercase;
    padding: 2px 6px 14px;
    opacity:.85;
  }
  .hud span.dim{ color:#7a6947; }

  /* ---------------- CLOSED BOOK / COVER ---------------- */
  #coverScene{ perspective: 1800px; }
  .book-cover{
    width: min(88vw, 360px);
    aspect-ratio: 3/4;
    background:
      radial-gradient(120% 90% at 30% 15%, rgba(255,255,255,0.05), transparent 60%),
      linear-gradient(160deg, var(--leather-light) 0%, var(--leather) 45%, var(--leather-dark) 100%);
    border-radius: 4px;
    box-shadow: 0 30px 60px rgba(0,0,0,.55), 0 2px 0 rgba(255,255,255,.04) inset, 0 0 0 1px rgba(0,0,0,.4);
    position:relative;
    cursor:pointer;
    transform-style:preserve-3d;
    transition: transform .5s cubic-bezier(.2,.8,.2,1), box-shadow .5s ease;
    padding: 22px;
    display:flex; flex-direction:column;
  }
  .book-cover:hover{ transform: translateY(-4px) rotateY(-3deg); box-shadow: 0 40px 70px rgba(0,0,0,.6);}
  .book-cover::before{
    content:""; position:absolute; inset:10px;
    border: 1.5px solid rgba(217,178,95,.55);
    border-radius:3px;
    pointer-events:none;
  }
  .book-cover::after{
    content:""; position:absolute; inset:16px;
    border: 1px solid rgba(217,178,95,.25);
    border-radius:2px;
    pointer-events:none;
  }
  .age-ribbon{
    align-self:flex-start;
    background: var(--age-maastrichtian);
    color:#22300c;
    font-family:'Spectral SC', serif;
    font-weight:600; font-size:11.5px; letter-spacing:.05em;
    padding:5px 12px;
    border-radius:2px;
    box-shadow: 0 2px 4px rgba(0,0,0,.35);
    margin-bottom: auto;
  }
  .cover-title{
    font-family:'Cinzel', serif; font-weight:700;
    color: var(--gold-title);
    text-align:center;
    font-size: clamp(22px, 6vw, 30px);
    letter-spacing:.03em;
    margin: 18px 0 2px;
    text-shadow: 0 2px 8px rgba(0,0,0,.5);
  }
  .cover-subtitle{
    text-align:center; color:#d8c69a; font-style:italic; font-size:15px; margin-bottom:14px;
  }
  .cover-emblem{
    width:78px; height:78px; margin: 6px auto 14px;
    display:flex; align-items:center; justify-content:center;
  }
  .cover-summary{
    color:#c9b285; font-size:13.5px; line-height:1.5; text-align:center; padding:0 6px;
    margin-top:auto;
  }
  .cover-footer{
    margin-top:14px; padding-top:10px; border-top:1px solid rgba(217,178,95,.3);
    display:flex; justify-content:space-between; align-items:baseline;
    font-family:'Spectral SC', serif; font-size:10.5px; letter-spacing:.06em; color:#a98f5e; text-transform:uppercase;
  }
  .tap-hint{
    margin-top:22px; color:#a3906a; font-family:'Spectral SC', serif; letter-spacing:.12em;
    font-size:11.5px; text-transform:uppercase; text-align:center; animation: pulse 2.4s ease-in-out infinite;
  }
  @keyframes pulse{ 0%,100%{opacity:.55} 50%{opacity:1} }

  /* ---------------- OPEN BOOK SHELL ---------------- */
  #readerScene{ display:none; width:100%; max-width:1080px; }
  .reader-frame{
    background: linear-gradient(180deg, #2c1c10, #1c1109);
    border-radius: 10px;
    box-shadow: 0 30px 70px rgba(0,0,0,.55), 0 0 0 1px rgba(0,0,0,.5);
    padding: 14px 14px 0;
  }

  /* top brass plaque header */
  .plaque{
    background: linear-gradient(180deg, var(--brass-light), var(--brass) 55%, var(--brass-dark));
    border-radius: 5px;
    padding: 10px 16px;
    display:flex; align-items:center; gap:14px;
    box-shadow: 0 2px 0 rgba(255,255,255,.25) inset, 0 3px 8px rgba(0,0,0,.4);
  }
  .plaque-title{
    font-family:'Cinzel', serif; font-weight:600; color:#3a2506; font-size: clamp(15px,3.4vw,19px);
    letter-spacing:.02em; flex:1; min-width:0;
  }
  .plaque-title small{ display:block; font-family:'Cormorant Garamond',serif; font-style:italic; font-weight:500; font-size:12px; color:#4a3308; }
  .status-badge{
    font-family:'Spectral SC', serif; font-size:10px; letter-spacing:.05em; text-transform:uppercase;
    background: rgba(58,37,6,.85); color:#e7c98a; padding:4px 9px; border-radius:3px; white-space:nowrap;
  }
  .icon-btn{
    width:30px; height:30px; border-radius:50%; border:none; cursor:pointer;
    background: rgba(58,37,6,.18); color:#3a2506; font-size:16px; font-weight:700;
    display:flex; align-items:center; justify-content:center; flex-shrink:0;
    transition: background .15s ease;
  }
  .icon-btn:hover{ background: rgba(58,37,6,.32); }

  /* tab bar (leather book spines / tab feel) */
  .tabbar{
    display:flex; gap:4px; overflow-x:auto; padding: 12px 4px 0;
    scrollbar-width: none;
  }
  .tabbar::-webkit-scrollbar{ display:none; }
  .tab{
    flex: 0 0 auto;
    font-family:'Spectral SC', serif; font-size:11.5px; letter-spacing:.04em; text-transform:uppercase;
    color:#cbb47e; background: rgba(255,255,255,0.03);
    border: 1px solid rgba(217,178,95,.25); border-bottom:none;
    padding: 9px 14px 8px; border-radius: 6px 6px 0 0;
    cursor:pointer; white-space:nowrap;
    transition: background .15s ease, color .15s ease;
  }
  .tab .n{ opacity:.55; margin-right:6px; font-size:10px; }
  .tab.active{
    background: var(--parchment); color:#3a2506; border-color: var(--parchment);
  }
  .tab:not(.active):hover{ background: rgba(255,255,255,0.07); color:#f0dfae; }

  /* the parchment page area */
  .page-area{
    background: linear-gradient(160deg, var(--parchment) 0%, var(--parchment-dark) 100%);
    border-radius: 0 4px 4px 4px;
    padding: 22px;
    min-height: 60vh;
    box-shadow: 0 -1px 0 rgba(217,178,95,.4) inset;
    position:relative;
  }
  .page-area::after{
    content:""; position:absolute; inset:0; border-radius:0 4px 4px 4px; pointer-events:none;
    box-shadow: inset 0 0 60px rgba(90,60,20,.18);
  }
  .spread{
    display:grid; grid-template-columns: 1fr 1fr; gap: 26px;
  }
  @media (max-width: 760px){
    .spread{ grid-template-columns: 1fr; gap:18px; }
  }
  .panel-title{
    font-family:'Cinzel', serif; font-weight:600; font-size:15px; letter-spacing:.03em;
    color:#5a3d18; border-bottom: 1px solid rgba(90,61,24,.3); padding-bottom:6px; margin: 0 0 12px;
  }
  .col{ min-width:0; }
  p.body-text{ font-family:'Merriweather', serif; font-size:15px; line-height:1.65; color:var(--ink-soft); margin:0 0 12px;}
  .field-note{ font-family:'Caveat', cursive; font-size:18px; color:#6b4a20; }

  /* brass label chip */
  .chip{
    display:inline-flex; align-items:center; gap:5px;
    font-family:'Spectral SC', serif; font-size:10.5px; letter-spacing:.05em; text-transform:uppercase;
    background: rgba(90,61,24,.1); border:1px solid rgba(90,61,24,.25); color:#5a3d18;
    padding:3px 9px; border-radius:3px; margin: 0 6px 6px 0;
  }
  .chip.warn{ background: rgba(178, 90, 30, .12); border-color: rgba(178,90,30,.4); color:#8a4e17; }
  .chip.high{ background: rgba(60,110,60,.12); border-color: rgba(60,110,60,.35); color:#2f5c2f; }

  /* warning banner - matches spec's "never invent missing data" fallback style */
  .warning-note{
    background: repeating-linear-gradient(135deg, rgba(178,90,30,.08), rgba(178,90,30,.08) 6px, rgba(178,90,30,.03) 6px, rgba(178,90,30,.03) 12px);
    border:1px dashed rgba(150,80,25,.55);
    border-radius:4px; padding:10px 12px; margin: 0 0 14px;
    font-family:'Spectral SC', serif; font-size:11.5px; letter-spacing:.02em; color:#7a3f10;
  }
  .warning-note b{ color:#5c2c08; }

  /* generic content card (specimen / taxon / mission / reference) */
  .card{
    background: rgba(255,255,255,.35);
    border:1px solid rgba(90,61,24,.18);
    border-radius:5px; padding:12px 13px; margin-bottom:10px;
  }
  .card h4{ margin:0 0 3px; font-family:'Cinzel', serif; font-size:13px; color:#4a3210; }
  .card .sub{ font-size:12px; color:#7a6647; font-style:italic; margin-bottom:5px;}
  .card .meta{ font-size:11.5px; color:#5a3d18; }

  .grid-cards{ display:grid; grid-template-columns: 1fr 1fr; gap:10px; }
  @media (max-width:520px){ .grid-cards{ grid-template-columns:1fr; } }

  /* stratigraphy column */
  .strat-col{ border:1px solid rgba(90,61,24,.3); border-radius:4px; overflow:hidden; }
  .strat-unit{ padding:10px 12px; border-bottom:1px solid rgba(90,61,24,.18); font-size:12.5px; }
  .strat-unit:last-child{ border-bottom:none; }
  .strat-unit .swatch{ display:inline-block; width:11px; height:11px; border-radius:2px; margin-right:7px; vertical-align:-1px; box-shadow:0 0 0 1px rgba(0,0,0,.2) inset;}
  .strat-unit b{ display:block; font-family:'Cinzel', serif; font-weight:600; font-size:12.5px; color:#4a3210; margin-bottom:1px;}
  .strat-unit span.lith{ color:#7a6647; font-style:italic; }
  .strat-top-bottom{ display:flex; justify-content:space-between; font-family:'Spectral SC', serif; font-size:9.5px; letter-spacing:.08em; color:#8a7550; padding:5px 12px;}

  /* hero landscape svg wrapper */
  .hero-wrap{ position:relative; border-radius:5px; overflow:hidden; border:1px solid rgba(90,61,24,.3); margin-bottom:12px;}
  .hero-wrap .tag{
    position:absolute; left:8px; bottom:8px; background:rgba(40,26,10,.82); color:#e8d29a;
    font-family:'Spectral SC', serif; font-size:9.5px; letter-spacing:.05em; padding:4px 8px; border-radius:3px;
  }
  .hero-wrap .plate{
    position:absolute; top:8px; left:8px; background:rgba(20,13,6,.75); color:#f2e4bf;
    font-family:'Cinzel', serif; font-size:11px; padding:5px 9px; border-radius:3px;
  }

  /* map placeholder */
  .map-box{
    border:1px solid rgba(90,61,24,.3); border-radius:4px; background:
      linear-gradient(0deg, rgba(90,61,24,.05), rgba(90,61,24,.05)),
      repeating-linear-gradient(0deg, transparent, transparent 23px, rgba(90,61,24,.12) 23px, rgba(90,61,24,.12) 24px),
      repeating-linear-gradient(90deg, transparent, transparent 23px, rgba(90,61,24,.12) 23px, rgba(90,61,24,.12) 24px);
    padding: 16px; min-height:170px; position:relative; margin-bottom:12px;
  }
  .map-box .cap{ font-family:'Spectral SC', serif; font-size:10px; letter-spacing:.04em; color:#7a6647; text-transform:uppercase;}
  .pin{ position:absolute; width:14px;height:14px;border-radius:50%; background:#7a3f1f; box-shadow:0 0 0 4px rgba(122,63,31,.25);}
  .pin-label{ position:absolute; font-family:'Cormorant SC',serif; font-size:12px; color:#4a3210; white-space:nowrap;}

  .refbtn{ font-family:'Spectral SC', serif; font-size:10.5px; letter-spacing:.04em; text-transform:uppercase;
    background:transparent; border:1px solid rgba(90,61,24,.4); color:#5a3d18; padding:5px 10px; border-radius:3px; cursor:pointer;}
  .refbtn:hover{ background: rgba(90,61,24,.08); }

  /* bottom action row */
  .actionrow{ display:flex; gap:10px; justify-content:flex-end; padding: 14px 4px 18px; flex-wrap:wrap; }
  .actbtn{
    font-family:'Cinzel', serif; font-size:12px; letter-spacing:.03em; text-transform:uppercase;
    padding:10px 18px; border-radius:4px; border:none; cursor:pointer;
    background: linear-gradient(180deg, var(--brass-light), var(--brass-dark)); color:#2c1c05;
    box-shadow: 0 2px 6px rgba(0,0,0,.35);
  }
  .actbtn.secondary{ background: transparent; border:1px solid #9c8656; color:#cbb47e; }
  .actbtn:disabled{ opacity:.45; cursor:not-allowed; }

  .toast{
    position:fixed; bottom:22px; left:50%; transform:translateX(-50%) translateY(20px);
    background: rgba(30,19,9,.95); color:#e8d29a; border:1px solid rgba(217,178,95,.4);
    padding:10px 18px; border-radius:6px; font-family:'Spectral SC', serif; font-size:12px; letter-spacing:.03em;
    opacity:0; transition: opacity .25s ease, transform .25s ease; pointer-events:none; z-index:50; max-width:88vw; text-align:center;
  }
  .toast.show{ opacity:1; transform:translateX(-50%) translateY(0); }
</style>
</head>
<body>

<div class="stage">

  <div class="hud">
    <span>ChronoArchive <span class="dim">/ Library / Formation Books</span></span>
    <span class="dim">Prototype reader — Formation Book spec v1.0</span>
  </div>

  <!-- ============ CLOSED COVER ============ -->
  <div id="coverScene">
    <div class="book-cover" id="openBookBtn" role="button" tabindex="0" aria-label="Open Lecho Formation book">
      <div class="age-ribbon">Maastrichtian · 72.0–66.0 Ma</div>
      <div class="cover-title">Lecho Formation</div>
      <div class="cover-subtitle">Estancia El Brete</div>
      <div class="cover-emblem">
        <svg viewBox="0 0 100 100" width="72" height="72">
          <circle cx="50" cy="50" r="46" fill="none" stroke="#d9b25f" stroke-width="1.4" opacity=".6"/>
          <path d="M20 70 Q 30 40 45 42 Q 42 30 55 20 Q 60 35 58 46 Q 72 44 78 60 Q 60 58 52 66 Q 60 72 62 80 Q 45 78 40 68 Q 30 78 20 70 Z"
                fill="#d9b25f" opacity=".9"/>
        </svg>
      </div>
      <div class="cover-summary">A Late Cretaceous formation in northwestern Argentina preserving the El Brete vertebrate assemblage, including Saltasaurus, Noasaurus, and diverse enantiornithine birds.</div>
      <div class="cover-footer"><span>Argentina</span><span>Chrono Archive · Field Monograph</span></div>
    </div>
    <div class="tap-hint">Tap the book to open it</div>
  </div>

  <!-- ============ OPEN READER ============ -->
  <div id="readerScene">
    <div class="reader-frame">
      <div class="plaque">
        <div class="plaque-title">Lecho Formation <small>Estancia El Brete · Salta Province, Argentina</small></div>
        <div class="status-badge">Canonical Candidate</div>
        <button class="icon-btn" id="minimizeBtn" title="Minimize">–</button>
        <button class="icon-btn" id="closeBtn" title="Close book">✕</button>
      </div>

      <div class="tabbar" id="tabbar"></div>
      <div class="page-area" id="pageArea"></div>
      <div class="actionrow">
        <button class="actbtn secondary" id="takeBookBtn">Take Book</button>
        <button class="actbtn" id="openMapBtn">Open Map</button>
      </div>
    </div>
  </div>

</div>

<div class="toast" id="toast"></div>

<script>
/* =========================================================================
   DATA LAYER
   Modeled on book_manifest.json + panel contracts from the ChronoArchive
   Book Generation Specification v1.0, populated with the worked Lecho /
   Estancia El Brete example (spec section 14) plus the corresponding rows
   in the ChronoGlobe Master Database (03_FormationPacks, 04_Localities,
   28_FormationBooks, 38_Taxa_Canonical, 40_FormationOccurrences,
   41_SpecimenInstances, 07_SourceRecords, 08_ContributorCredits).
   Where the master database only carries a placeholder record for a field
   (true of most Lecho rows as of v0.3.8), that is shown honestly as a
   pending-review item rather than invented — per the spec's "no
   fabrication" rule.
   ========================================================================= */

const manifest = {
  formationId: "lecho_formation",
  localityId: "locality_el_brete",
  bookId: "BOOK_FORM_LECHO_ELBRETE",
  displayName: "Lecho Formation",
  generatedMode: "draft",
  canonicalStatus: "CanonicalCandidate",
  sourceDatabaseVersion: "ChronoGlobe_MasterDatabase_Backbone_v0_3_8-compatible",
  warnings: [
    { code: "PALEOCOORDS_PENDING", message: "Reviewed paleocoordinates are missing. The paleo-position map is a visible fallback, not an invented pin.", severity: "warning" },
    { code: "LOCALITY_REVIEW", message: "Locality record still requires source-snapshot verification.", severity: "warning" },
    { code: "SOURCE_PLACEHOLDER", message: "07_SourceRecords currently holds a placeholder citation for this formation (src_placeholder_lecho_01). Replace with the real paper/dataset before release.", severity: "warning" }
  ]
};

const taxa = [
  { name:"Saltasaurus loricatus", group:"Sauropoda · Titanosauria", role:"Hero taxon", conf:"Needs Review", note:"Armored titanosaur; namesake of the formation's most recognizable fossil, its dermal osteoderms." },
  { name:"Noasaurus leali", group:"Theropoda · Noasauridae", role:"Featured", conf:"Needs Review", note:"Small, agile theropod known chiefly from an enlarged, sickle-like manual ungual." },
  { name:"Abelisauridae indet.", group:"Theropoda · Abelisauridae", role:"Featured", conf:"Needs Review", note:"Larger-bodied abelisaurid theropod, represented by fragmentary material." },
  { name:"Elbretornis bonapartei", group:"Aves · Enantiornithes", role:"Featured", conf:"Needs Review", note:"One of several enantiornithine ('opposite') birds recovered from the El Brete bonebed." },
  { name:"Enantiornis leali", group:"Aves · Enantiornithes", role:"Featured", conf:"Needs Review", note:"Type genus for Enantiornithes, first described from this locality." },
  { name:"Lectavis bretincola", group:"Aves · Enantiornithes", role:"Standard", conf:"Needs Review", note:"Enantiornithine bird described from El Brete postcranial material." },
  { name:"Soroavisaurus australis", group:"Aves · Enantiornithes / Avisauridae", role:"Standard", conf:"Needs Review", note:"Avisaurid enantiornithine, part of the diverse El Brete bird assemblage." },
  { name:"Yungavolucris brevipedalis", group:"Aves · Enantiornithes", role:"Standard", conf:"Needs Review", note:"Small enantiornithine bird known from hindlimb elements." },
  { name:"Martinavis spp.", group:"Aves · Enantiornithes", role:"Standard", conf:"Needs Review", note:"Enantiornithine genus with multiple named species across South America." },
  { name:"Fiorilloia tordoffi", group:"Testudines", role:"Standard", conf:"Needs Review", note:"Turtle taxon contributing to the formation's broader vertebrate picture." },
  { name:"Cycadales indet.", group:"Plantae", role:"Contextual", conf:"Needs Review", note:"Cycad plant remains, part of the flora record for the formation." },
];

const specimens = [
  { name:"Saltasaurus osteoderm", type:"Dermal armor plate", conf:"Very High", tab:"fauna" },
  { name:"Saltasaurus vertebral element", type:"Vertebra", conf:"High", tab:"fauna" },
  { name:"Noasaurus manual ungual", type:"Hand claw", conf:"Very High", tab:"fauna" },
  { name:"Elbretornis wing-bone set", type:"Scapula, coracoid, humerus, radius, ulna", conf:"Very High", tab:"fauna" },
  { name:"Bioturbated sandstone slab", type:"Geological sample", conf:"High", tab:"evidence" },
  { name:"Bonebed matrix block", type:"Geological / taphonomic sample", conf:"High", tab:"evidence" },
];

const strat = [
  { label:"Overbank siltstone / mudstone", lith:"siltstone", color:"#a9855a" },
  { label:"Fine-grained bioturbated sandstone", lith:"sandstone", color:"#c79a5b" },
  { label:"Disarticulated vertebrate bonebed interval", lith:"bonebed matrix", color:"#8a5738" },
  { label:"Reddish channel sandstone", lith:"red sandstone", color:"#a8532e" },
  { label:"Basal channel lag / coarse sandstone", lith:"coarse sandstone", color:"#b98a55" },
];

const references = [
  { id:"src_placeholder_lecho_01", title:"Lecho Formation source placeholder", authors:"TBD", year:"TBD", used:"formation age; taxa; environment", status:"Needs Review", rights:"TBD" }
];
const contributors = [
  { name:"TBD researcher", role:"Researcher / field scientist", discipline:"Paleontology", note:"Research by TBD made this formation record possible.", flag:"Add real names only from sourced records." }
];

const missions = [
  { name:"Survey the El Brete bonebed", reward:"Field credits · 1 mapped tile", state:"Available" },
  { name:"Recover the Saltasaurus osteoderm", reward:"Specimen · Prestige +1", state:"Available" },
  { name:"Photograph the enantiornithine bird assemblage", reward:"Field photo · Wall of Life unlock", state:"Locked — requires camera tool" },
];
const hiddenItem = { id:"MAPPIECE_LECHO_001", note:"A folded map fragment is tucked into the book's back cover — a hook for the Expedition Desk map puzzle." };

/* =========================================================================
   TABS  — the eight-tab reader bindings from spec section 9
   ========================================================================= */
const tabs = [
  { id:"overview", label:"Overview", render: renderOverview },
  { id:"life_forms", label:"Life Forms", render: renderLifeForms },
  { id:"paleoenvironment", label:"Paleoenvironment", render: renderPaleoenvironment },
  { id:"flora", label:"Flora", render: renderFlora },
  { id:"fauna", label:"Fauna", render: renderFauna },
  { id:"evidence", label:"Evidence", render: renderEvidence },
  { id:"history", label:"History of Discovery", render: renderHistory },
  { id:"references_collections", label:"References & Collections", render: renderReferences },
];

let activeTab = "overview";

function warningsBlock(codes){
  const items = manifest.warnings.filter(w => codes.includes(w.code));
  if(!items.length) return "";
  return `<div class="warning-note">${items.map(w=>`<div>⚠ <b>${w.code.replaceAll('_',' ')}:</b> ${w.message}</div>`).join("")}</div>`;
}

function confChip(conf){
  const cls = /very high|high/i.test(conf) ? "high" : (/needs review|tbd|pending/i.test(conf) ? "warn" : "");
  return `<span class="chip ${cls}">${conf}</span>`;
}

/* ---------- Tab 1 · Overview ---------- */
function renderOverview(){
  return `
  <div class="spread">
    <div class="col">
      <div class="panel-title">Modern Locator Map</div>
      <div class="map-box">
        <div class="cap">Estancia El Brete · Lecho Formation, Maastrichtian — precision: regional centroid (prototype)</div>
        <div class="pin" style="left:46%; top:56%;"></div>
        <div class="pin-label" style="left:50%; top:52%;">Estancia El Brete</div>
      </div>
      ${warningsBlock(["LOCALITY_REVIEW"])}
    </div>
    <div class="col">
      <div class="panel-title">Formation Overview</div>
      <p class="body-text">The Lecho Formation is a fluvial to marginal-marine deposit of the Late Cretaceous (Maastrichtian) in northwestern Argentina. It has yielded an exceptional vertebrate fauna including titanosaur sauropods, abelisaurids, birds, turtles, and crocodyliforms, as well as diverse plant remains.</p>
      <span class="chip">Maastrichtian · 72.0–66.0 Ma</span>
      <span class="chip">Salta Province, Argentina</span>
      <span class="chip">Terrestrial fluvial / floodplain</span>
      <span class="chip warn">Scope: formation-level book, El Brete vertical slice</span>
      <p class="body-text" style="margin-top:12px;">This first playable slice focuses on <b>Estancia El Brete</b> specifically. Younger, similarly named El Brete records and other Lecho localities are kept out of this scope by design — the generator does not silently merge them.</p>
    </div>
  </div>`;
}

/* ---------- Tab 2 · Life Forms ---------- */
function renderLifeForms(){
  return `
  <div class="panel-title">Life Forms — All Recorded Taxa</div>
  <div class="grid-cards">
    ${taxa.map(t=>`
      <div class="card">
        <h4>${t.name}</h4>
        <div class="sub">${t.group}</div>
        <div class="meta">${confChip(t.conf)} <span class="chip">${t.role}</span></div>
      </div>`).join("")}
  </div>`;
}

