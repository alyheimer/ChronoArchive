/* ---------- Tab 4 · Flora ---------- */
function renderFlora(){
  const flora = taxa.filter(t => t.group === "Plantae");
  return `
  <div class="panel-title">Flora — Direct Locality Records</div>
  <div class="grid-cards">
    ${flora.map(t=>`
      <div class="card">
        <h4>${t.name}</h4>
        <div class="sub">${t.group}</div>
        <div class="meta">${confChip(t.conf)}</div>
        <p class="body-text" style="margin-top:8px; font-size:13.5px;">${t.note}</p>
      </div>`).join("")}
  </div>
  <div class="warning-note">Contextual regional palynology (pollen/spore records from nearby, non-El-Brete sections) is deliberately kept out of this list per the Lecho scope exclusion rule — it may only appear elsewhere as clearly labeled contextual evidence.</div>`;
}

/* ---------- Tab 5 · Fauna ---------- */
function renderFauna(){
  const fauna = taxa.filter(t => t.group !== "Plantae");
  const faunaSpec = specimens.filter(s => s.tab === "fauna");
  return `
  <div class="spread">
    <div class="col">
      <div class="panel-title">Fauna — Animal Groups</div>
      ${fauna.map(t=>`
        <div class="card">
          <h4>${t.name}</h4>
          <div class="sub">${t.group}</div>
          <div class="meta">${confChip(t.conf)} <span class="chip">${t.role}</span></div>
          <p class="body-text" style="margin-top:7px; font-size:13.5px;">${t.note}</p>
        </div>`).join("")}
    </div>
    <div class="col">
      <div class="panel-title">Specimen Cards</div>
      <div class="grid-cards">
        ${faunaSpec.map(s=>`
          <div class="card">
            <h4>${s.name}</h4>
            <div class="sub">${s.type}</div>
            <div class="meta">${confChip(s.conf)}</div>
          </div>`).join("")}
      </div>
    </div>
  </div>`;
}

/* ---------- Tab 6 · Evidence ---------- */
function renderEvidence(){
  const evSpec = specimens.filter(s => s.tab === "evidence");
  return `
  <div class="spread">
    <div class="col">
      <div class="panel-title">Stratigraphic Column</div>
      <div class="strat-top-bottom"><span>TOP</span><span>Fine-grained bioturbated sandstone with reddish sandstone and bonebed matrix evidence</span></div>
      <div class="strat-col">
        ${strat.map(u=>`
          <div class="strat-unit">
            <b><span class="swatch" style="background:${u.color}"></span>${u.label}</b>
            <span class="lith">${u.lith}</span>
          </div>`).join("")}
      </div>
      <div class="strat-top-bottom"><span>BOTTOM</span><span>Cross-bedded channel sandstone; schematic until a measured section is imported</span></div>
      <div class="warning-note" style="margin-top:12px;">This column is explicitly <b>schematic</b>, not a measured section — the spec requires that distinction stay visible so it is never mistaken for surveyed data.</div>
    </div>
    <div class="col">
      <div class="panel-title">Evidence / Context Cards</div>
      <div class="grid-cards">
        ${evSpec.map(s=>`
          <div class="card">
            <h4>${s.name}</h4>
            <div class="sub">${s.type}</div>
            <div class="meta">${confChip(s.conf)}</div>
          </div>`).join("")}
      </div>
      <p class="body-text" style="margin-top:10px;">These records feed the same evidence chain used by the Wall of Life and the Collections Hall — collecting a specimen here updates progress in both places.</p>
    </div>
  </div>`;
}

/* ---------- Tab 7 · History of Discovery ---------- */
function renderHistory(){
  return `
  <div class="panel-title">History of Discovery</div>
  ${warningsBlock(["SOURCE_PLACEHOLDER"])}
  <div class="card">
    <h4>Field research credit</h4>
    ${contributors.map(c=>`
      <p class="body-text" style="margin:6px 0;"><i>${c.note}</i></p>
      <div class="meta">${c.role} · ${c.discipline}</div>
      <div class="warning-note" style="margin-top:8px;">${c.flag}</div>
    `).join("")}
  </div>
  <p class="body-text field-note" style="margin-top:10px;">Once real expedition history is sourced, this page becomes a timeline of surveys, publications, and revisions for Estancia El Brete.</p>`;
}

/* ---------- Tab 8 · References & Collections ---------- */
function renderReferences(){
  return `
  <div class="panel-title">References &amp; Collections</div>
  ${references.map(r=>`
    <div class="card">
      <h4>${r.title}</h4>
      <div class="sub">${r.authors} · ${r.year}</div>
      <div class="meta">Used for: ${r.used}</div>
      <div class="meta">${confChip(r.status)} <span class="chip">Rights: ${r.rights}</span></div>
    </div>`).join("")}
  <div class="warning-note">Per the spec's attribution rule, every release-facing claim must resolve to a source or provenance record. This formation currently cites one placeholder source and is not release-ready until that is replaced.</div>
  <div class="panel-title" style="margin-top:16px;">Book Quest Hook</div>
  <div class="card">
    <h4>${hiddenItem.id}</h4>
    <div class="meta">${hiddenItem.note}</div>
  </div>
  <div class="panel-title" style="margin-top:16px;">Expedition Missions</div>
  ${missions.map(m=>`
    <div class="card">
      <h4>${m.name}</h4>
      <div class="meta">${m.reward} · <span class="chip ${m.state.startsWith('Locked')?'warn':'high'}">${m.state}</span></div>
    </div>`).join("")}
  `;
}

/* =========================================================================
   WIRING
   ========================================================================= */
function buildTabbar(){
  const bar = document.getElementById("tabbar");
  bar.innerHTML = tabs.map((t,i)=>`<div class="tab${t.id===activeTab?' active':''}" data-id="${t.id}"><span class="n">${i+1}</span>${t.label}</div>`).join("");
  bar.querySelectorAll(".tab").forEach(el=>{
    el.addEventListener("click", ()=>{ activeTab = el.dataset.id; renderPage(); });
  });
}
function renderPage(){
  buildTabbar();
  const tab = tabs.find(t=>t.id===activeTab);
  document.getElementById("pageArea").innerHTML = tab.render();
  document.getElementById("pageArea").scrollTop = 0;
}

let toastTimer;
function showToast(msg){
  const el = document.getElementById("toast");
  el.textContent = msg;
  el.classList.add("show");
  clearTimeout(toastTimer);
  toastTimer = setTimeout(()=> el.classList.remove("show"), 2600);
}

function openBook(){
  document.getElementById("coverScene").style.display = "none";
  document.getElementById("readerScene").style.display = "block";
  activeTab = "overview";
  renderPage();
}
function closeBook(){
  document.getElementById("readerScene").style.display = "none";
  document.getElementById("coverScene").style.display = "block";
}

document.getElementById("openBookBtn").addEventListener("click", openBook);
document.getElementById("openBookBtn").addEventListener("keypress", e=>{ if(e.key==="Enter") openBook(); });
document.getElementById("closeBtn").addEventListener("click", closeBook);
document.getElementById("minimizeBtn").addEventListener("click", ()=> showToast("Book minimized to the Library shelf (prototype stub)."));
document.getElementById("takeBookBtn").addEventListener("click", ()=> showToast("Book added to inventory (prototype stub)."));
document.getElementById("openMapBtn").addEventListener("click", ()=> showToast("This would hand off to the Expedition Map Puzzle / Chrono-Globe Navigator flow."));

</script>
